From 5b9daf2e25decde8980fdd47149341e6dcfda470 Mon Sep 17 00:00:00 2001
From: [identity stripped -- see the README for provenance]
Date: Fri, 10 Jul 2026 15:14:30 +1200
Subject: [PATCH 2/2] deepseek4 metal rounds 2-3: gather top-k keys at decode;
 fuse indexer scorer tail

- decode (n_tokens==1, n_comp_visible > top_k): get_rows-gather the selected
  compressed keys instead of dense attention over the full compressed cache with a
  -1e9 mask. Attention cost per decode step becomes O(swa_window + top_k) fixed
  instead of O(n_comp_visible) growing with context. Gathered rows are cast back to
  the cache type (get_rows dequantizes to f32; raw KV rows are type_k).
- indexer scorer tail (prefill + decode): sum_h relu(score)[c,t,h] * w[h,t] now
  goes through a permute view into the stride-aware dsv4_hc_weighted_sum kernel,
  replacing broadcast-mul + cont([n_heads,n_comp,n_tokens] materialization, which
  scales with context) + sum_rows.
- Verified: greedy seed-1234 golden outputs EXACT vs baseline at 4K (48 tok) and
  16K (64 tok, both paths active). 16242-token prompt on M3 Max: prefill 121.7 ->
  130.4 t/s (+7.1%), decode-at-16K 14.30 -> 16.69 t/s (+16.7%), compute buffer
  1745 -> 1169 MiB. Gains grow with depth: gathered top-512 is fixed-size while the
  masked dense set keeps growing (262144 compressed keys at 1M ctx).
- Not addressed: llama-bench tg-at-depth fails on this fork independent of these
  changes (test_prompt res=1 during the tg depth refill; pp-at-depth works).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 src/models/deepseek4.cpp | 47 +++++++++++++++++++++++++++++-----------
 1 file changed, 34 insertions(+), 13 deletions(-)

diff --git a/src/models/deepseek4.cpp b/src/models/deepseek4.cpp
index 6930e8f29..f2d2885ce 100644
--- a/src/models/deepseek4.cpp
+++ b/src/models/deepseek4.cpp
@@ -836,13 +836,12 @@ static ggml_tensor * dsv4_build_indexer_scores_prefill(
     ggml_tensor * weights = ggml_mul_mat(ctx, wproj, x);      // [n_heads, n_tokens]
     const float scale = 1.0f / std::sqrt(float(n_index_head_size) * float(n_index_head));
     weights = dsv4_mul_scalar(ctx, weights, scale);
-    weights = ggml_reshape_3d(ctx, weights, 1, n_index_head, n_tokens);
-    weights = ggml_permute(ctx, weights, 0, 2, 1, 3);         // [1, n_tokens, n_heads]
 
-    score = ggml_mul(ctx, score, weights);
-    score = ggml_cont(ctx, ggml_permute(ctx, score, 1, 2, 0, 3)); // [n_heads, n_comp, n_tokens]
-    score = ggml_sum_rows(ctx, score);                            // [1, n_comp, n_tokens]
-    score = ggml_reshape_2d(ctx, score, index_kv->ne[2], n_tokens);
+    // sum_h score[c,t,h] * w[h,t] via the stride-aware fused kernel: a permute VIEW
+    // adapts the layout, avoiding the former mul + cont([n_heads,n_comp,n_tokens]
+    // materialization, which grows with context) + sum_rows chain.
+    score = ggml_permute(ctx, score, 0, 2, 1, 3);             // view [n_comp, n_heads, n_tokens]
+    score = ggml_dsv4_hc_weighted_sum(ctx, score, weights);   // [n_comp, n_tokens]
 
     return ggml_add(ctx, score, causal_mask);
 }
@@ -878,13 +877,10 @@ static ggml_tensor * dsv4_build_indexer_scores_decode(
     ggml_tensor * weights = ggml_mul_mat(ctx, wproj, x); // [n_heads, 1]
     const float scale = 1.0f / std::sqrt(float(n_index_head_size) * float(n_index_head));
     weights = dsv4_mul_scalar(ctx, weights, scale);
-    weights = ggml_reshape_3d(ctx, weights, 1, n_index_head, 1);
-    weights = ggml_permute(ctx, weights, 0, 2, 1, 3); // [1, 1, n_heads]
 
-    score = ggml_mul(ctx, score, weights);
-    score = ggml_cont(ctx, ggml_permute(ctx, score, 1, 2, 0, 3)); // [n_heads, n_comp, 1]
-    score = ggml_sum_rows(ctx, score);
-    return ggml_reshape_2d(ctx, score, n_comp, 1);
+    // same fused reduction as the prefill scorer (see dsv4_build_indexer_scores_prefill)
+    score = ggml_permute(ctx, score, 0, 2, 1, 3);           // view [n_comp, n_heads, 1]
+    return ggml_dsv4_hc_weighted_sum(ctx, score, weights);  // [n_comp, 1]
 }
 
 static ggml_tensor * dsv4_build_compressed_mask_from_topk(
@@ -1291,7 +1287,32 @@ llm_build_deepseek4::llm_build_deepseek4(const llama_model & model, const llm_gr
                             ggml_tensor * topk = ggml_top_k(ctx0, index_scores, top_k);
                             cb(topk, "indexer_topk", il);
 
-                            comp_mask = dsv4_build_compressed_mask_from_topk(ctx0, index_scores, topk);
+                            if (n_tokens == 1) {
+                                // Single-query decode: gather the selected compressed keys
+                                // instead of masking the full cache. Attention cost becomes
+                                // O(top_k) instead of O(n_comp_visible) — at long context the
+                                // dense masked path dominates the whole decode budget.
+                                // Softmax over the gathered set is mathematically identical to
+                                // the -1e9 mask over all keys (permutation-invariant).
+                                ggml_tensor * comp_2d = ggml_reshape_2d(ctx0, kv_comp_cache,
+                                        kv_comp_cache->ne[0], n_comp_visible);
+                                ggml_tensor * gathered = ggml_get_rows(ctx0, comp_2d,
+                                        ggml_reshape_1d(ctx0, topk, top_k));
+                                if (gathered->type != k_raw->type) {
+                                    // get_rows dequantizes to f32; the raw KV cache rows are type_k
+                                    gathered = ggml_cast(ctx0, gathered, k_raw->type);
+                                }
+                                gathered = ggml_reshape_3d(ctx0, gathered, kv_comp_cache->ne[0], 1, top_k);
+                                cb(gathered, "dsv4_attn_compress_gathered", il);
+
+                                k_all = ggml_concat(ctx0, k_raw, gathered, 2);
+                                v_all = k_all;
+
+                                // all gathered keys are causally visible at decode: zero mask
+                                comp_mask = dsv4_new_filled_2d(ctx0, top_k, n_tokens, 0.0f);
+                            } else {
+                                comp_mask = dsv4_build_compressed_mask_from_topk(ctx0, index_scores, topk);
+                            }
                         }
                     } else {
                         comp_mask = get_dsv4_inputs()->add_mask(ctx0,
